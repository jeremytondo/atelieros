#!/usr/bin/env bash
# Boots a qcow2 in qemu the way Proxmox creates a VM from it, then checks it
# over SSH. The VM boots BIOS on a disk larger than the image, with a NoCloud
# seed shaped like Proxmox's user data. Its overlay disk is discarded
# afterwards, so the qcow2 is never modified.
#
# Usage: scripts/boot-test <qcow2>
# Needs qemu, KVM, xorriso, ssh and jq on the host.
set -euo pipefail

qcow2=$(realpath "${1:?usage: boot-test <qcow2>}")
port=${BOOT_TEST_SSH_PORT:-2222}
disk_size=20G
stable=ghcr.io/jeremytondo/atelieros:stable

work=$(mktemp -d)
cleanup() {
    [ -f "$work/qemu.pid" ] && kill "$(cat "$work/qemu.pid")" 2>/dev/null || true
    rm -rf "$work"
}
trap cleanup EXIT

ssh-keygen -q -t ed25519 -N "" -C boot-test -f "$work/key"
qemu-img create -q -f qcow2 -b "$qcow2" -F qcow2 "$work/disk.qcow2" "$disk_size"

# Proxmox sends `user:` as a string, which cloud-init reports as DEPRECATED.
mkdir "$work/seed"
cat >"$work/seed/user-data" <<EOF
#cloud-config
hostname: boot-test
manage_etc_hosts: true
fqdn: boot-test.local
user: tester
ssh_authorized_keys:
  - $(cat "$work/key.pub")
chpasswd:
  expire: False
users:
  - default
EOF
printf 'instance-id: boot-test-%s\nlocal-hostname: boot-test\n' "$(date +%s)" >"$work/seed/meta-data"
xorriso -as mkisofs -quiet -o "$work/seed.iso" -V cidata -J -r "$work/seed"

qemu-system-x86_64 \
    -machine q35,accel=kvm -cpu host -smp 2 -m 4096 \
    -drive file="$work/disk.qcow2",if=virtio \
    -drive file="$work/seed.iso",media=cdrom \
    -netdev user,id=net0,hostfwd=tcp:127.0.0.1:"$port"-:22 \
    -device virtio-net-pci,netdev=net0 \
    -display none -serial file:"$work/console.log" \
    -daemonize -pidfile "$work/qemu.pid"

vm() {
    ssh -i "$work/key" -p "$port" -o BatchMode=yes -o ConnectTimeout=5 \
        -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR \
        tester@127.0.0.1 "$@"
}

echo "Waiting for SSH on port $port"
for _ in $(seq 60); do
    vm true 2>/dev/null && break
    sleep 5
done
if ! vm true; then
    echo "SSH never came up. Console:"
    tail -n 50 "$work/console.log"
    exit 1
fi

failed=0
check() {
    if [ "$2" = "$3" ]; then
        echo "PASS  $1"
    else
        echo "FAIL  $1: expected '$3', got '$2'"
        failed=1
    fi
}

# Exits 2 when there are recoverable errors, so ignore its status and read the
# JSON. Like homelab's vm:check, only DEPRECATED notices are acceptable.
cloud_init=$(vm sudo cloud-init status --wait --format json || true)
echo "$cloud_init" | jq '{status, extended_status, errors, recoverable_errors}'
check "cloud-init finished" "$(jq -r .status <<<"$cloud_init")" done
check "cloud-init errors" "$(jq -c .errors <<<"$cloud_init")" "[]"
check "cloud-init warnings other than DEPRECATED" \
    "$(jq -c '.recoverable_errors | del(.DEPRECATED)' <<<"$cloud_init")" "{}"

bootc=$(vm sudo bootc status --json)
check "bootc tracks :stable" "$(jq -r .spec.image.image <<<"$bootc")" "$stable"
# image-builder pulls the reference from the registry when it can't find it
# locally, so check the disk holds the version it's named after.
if [[ $qcow2 =~ atelieros-(.+)\.qcow2$ ]]; then
    check "booted version" "$(jq -r .status.booted.image.version <<<"$bootc")" "${BASH_REMATCH[1]}"
fi
echo "      booted $(jq -r .status.booted.image.imageDigest <<<"$bootc")"

read -r disk sysroot < <(vm 'echo $(lsblk -bndo SIZE /dev/vda) $(findmnt -bno SIZE /sysroot)')
echo "      disk $disk bytes, /sysroot $sysroot bytes"
check "/sysroot fills the disk (over 90%)" "$((sysroot * 10 > disk * 9))" 1
check "bootc-generic-growpart succeeded" \
    "$(vm systemctl show -P Result bootc-generic-growpart.service)" success
vm journalctl -b -o cat -u bootc-generic-growpart.service | sed 's/^/      /'

# The image's own settings.
check "SELinux" "$(vm getenforce)" Enforcing
check "SSH password authentication" "$(vm sudo sshd -T | awk '$1 == "passwordauthentication" {print $2}')" no
check "SSH root login" "$(vm sudo sshd -T | awk '$1 == "permitrootlogin" {print $2}')" no
check "ptrace_scope" "$(vm cat /proc/sys/kernel/yama/ptrace_scope)" 1
check "public zone services" "$(vm sudo firewall-cmd --zone=public --list-services)" ssh
check "update timer is download-only" \
    "$(vm systemctl show -P ExecStart bootc-fetch-apply-updates.service | grep -o -- '--download-only')" --download-only

if [ "$failed" -ne 0 ]; then
    echo "Boot test failed"
    exit 1
fi
echo "Boot test passed"
